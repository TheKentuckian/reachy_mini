 3rd good read returns wake-gesture position      ← gate opens, held_since set\n  - hold timer requires _ANTENNA_SLEEP_HOLD_S more seconds to elapse\n  → wake_up must NOT have been called during the 5 reads tested here\n</code></pre>\n","environment":"default","setup":[{"id":"c306364c2387a79bf1a4fac7e6b3a8a8","type":"before","name":"_function_scoped_runner","status":"passed","steps":[],"duration":0},{"id":"1d65db4f0a4280a2766c3a10a24c8ed4","type":"before","name":"event_loop_policy","status":"passed","steps":[],"duration":0}],"teardown":[{"id":"3b7ed2041c337b4ed106d802f5444647","type":"after","name":"_function_scoped_runner::0","status":"passed","steps":[],"duration":2}],"history":[],"retries":[],"breadcrumbs":[["tests.unit_tests","test_antenna_sleep_monitor"]],"retry":false,"transition":"new","titlePath":["tests","unit_tests","test_antenna_sleep_monitor.py"],"retriesCount":0,"attachments":[{"link":{"used":true,"missed":false,"id":"4ecc1e1787705b2de16d499aeb53b56a","originalFileName":"0c5f6ad5-7976-464c-8fa0-390a366c20eb-attachment.txt","ext":".txt","contentType":"text/plain","contentLength":1525,"name":"log"},"type":"attachment"}],"order":3,"categories":[]}