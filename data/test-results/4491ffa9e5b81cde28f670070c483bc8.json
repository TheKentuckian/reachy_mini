 3rd good read returns wake-gesture position      ← gate opens, held_since set\n  - hold timer requires _ANTENNA_SLEEP_HOLD_S more seconds to elapse\n  → wake_up must NOT have been called during the 5 reads tested here\n</code></pre>\n","environment":"default","setup":[{"id":"a1ad6a95271730c5fdf4a37a2da1b450","type":"before","name":"event_loop_policy","status":"passed","steps":[],"duration":0},{"id":"0f17f5958a9778f3d6f23691aafc0e36","type":"before","name":"_function_scoped_runner","status":"passed","steps":[],"duration":1}],"teardown":[{"id":"35f5ab4cc568de92154b9f4eab7d9e43","type":"after","name":"_function_scoped_runner::0","status":"passed","steps":[],"duration":2}],"history":[{"id":"92a4af40be86f4ad5984c5a050a762a7","name":"test_no_wake_during_recovery_reads","fullName":"tests.unit_tests.test_antenna_sleep_monitor#test_no_wake_during_recovery_reads","environment":"default","status":"passed","start":1782989078293,"stop":1782989085839,"duration":7546,"labels":[{"name":"tag","value":"asyncio"},{"name":"parentSuite","value":"tests.unit_tests"},{"name":"suite","value":"test_antenna_sleep_monitor"},{"name":"host","value":"runnervmmklqx"},{"name":"thread","value":"3026-MainThread"},{"name":"framework","value":"pytest"},{"name":"language","value":"cpython3"},{"name":"package","value":"tests.unit_tests.test_antenna_sleep_monitor"}],"url":"","historyId":"fae683c65a1569e57edf97ba3d3c1733.d41d8cd98f00b204e9800998ecf8427e","reportLinks":[]},{"id":"59158e7d1085905d9bf32b290ed3d9c6","name":"test_no_wake_during_recovery_reads","fullName":"tests.unit_tests.test_antenna_sleep_monitor#test_no_wake_during_recovery_reads","environment":"default","status":"passed","start":1782987794226,"stop":1782987801799,"duration":7573,"labels":[{"name":"tag","value":"asyncio"},{"name":"parentSuite","value":"tests.unit_tests"},{"name":"suite","value":"test_antenna_sleep_monitor"},{"name":"host","value":"runnervmmklqx"},{"name":"thread","value":"3029-MainThread"},{"name":"framework","value":"pytes