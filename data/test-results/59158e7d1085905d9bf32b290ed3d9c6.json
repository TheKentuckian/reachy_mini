 3rd good read returns wake-gesture position      ← gate opens, held_since set\n  - hold timer requires _ANTENNA_SLEEP_HOLD_S more seconds to elapse\n  → wake_up must NOT have been called during the 5 reads tested here\n</code></pre>\n","environment":"default","setup":[{"id":"b6d3a90fea989a931c9bd92acac148bf","type":"before","name":"event_loop_policy","status":"passed","steps":[],"duration":1},{"id":"061cc18d7c4ab8ce463166e32ca2d0af","type":"before","name":"_function_scoped_runner","status":"passed","steps":[],"duration":1}],"teardown":[{"id":"a697d5380aa575d22f943179436056a6","type":"after","name":"_function_scoped_runner::0","status":"passed","steps":[],"duration":2}],"history":[{"id":"31fd8dbe3f64133ba5861afe11a4fe86","name":"test_no_wake_during_recovery_reads","fullName":"tests.unit_tests.test_antenna_sleep_monitor#test_no_wake_during_recovery_reads","environment":"default","status":"passed","start":1782945183464,"stop":1782945191021,"duration":7557,"labels":[{"name":"tag","value":"asyncio"},{"name":"parentSuite","value":"tests.unit_tests"},{"name":"suite","value":"test_antenna_sleep_monitor"},{"name":"host","value":"runnervmkkn4f"},{"name":"thread","value":"3368-MainThread"},{"name":"framework","value":"pytest"},{"name":"language","value":"cpython3"},{"name":"package","value":"tests.unit_tests.test_antenna_sleep_monitor"}],"url":"","historyId":"fae683c65a1569e57edf97ba3d3c1733.d41d8cd98f00b204e9800998ecf8427e","reportLinks":[]}],"retries":[],"breadcrumbs":[["tests.unit_tests","test_antenna_sleep_monitor"]],"retry":false,"titlePath":["tests","unit_tests","test_antenna_sleep_monitor.py"],"retriesCount":0,"attachments":[{"link":{"used":true,"missed":false,"id":"4720dbafec63d4a1cc305169facdfda1","originalFileName":"42fe18a5-bf15-43d8-9e71-7f029cb695c1-attachment.txt","ext":".txt","contentType":"text/plain","contentLength":1525,"name":"log"},"type":"attachment"}],"order":3,"categories":[]}