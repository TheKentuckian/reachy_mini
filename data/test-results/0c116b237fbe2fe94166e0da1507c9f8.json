 3rd good read returns wake-gesture position      ← gate opens, held_since set\n  - hold timer requires _ANTENNA_SLEEP_HOLD_S more seconds to elapse\n  → wake_up must NOT have been called during the 5 reads tested here\n</code></pre>\n","environment":"default","setup":[{"id":"b2860c38d8fc50b6c994e23ebb03501c","type":"before","name":"event_loop_policy","status":"passed","steps":[],"duration":0},{"id":"1ccb90bac1e4463336d0e7a31a7cced5","type":"before","name":"_function_scoped_runner","status":"passed","steps":[],"duration":1}],"teardown":[{"id":"1d66d688a0ad77c7a85de8e81786bf5e","type":"after","name":"_function_scoped_runner::0","status":"passed","steps":[],"duration":2}],"history":[{"id":"4491ffa9e5b81cde28f670070c483bc8","name":"test_no_wake_during_recovery_reads","fullName":"tests.unit_tests.test_antenna_sleep_monitor#test_no_wake_during_recovery_reads","environment":"default","status":"passed","start":1783021810934,"stop":1783021818533,"duration":7599,"labels":[{"name":"tag","value":"asyncio"},{"name":"parentSuite","value":"tests.unit_tests"},{"name":"suite","value":"test_antenna_sleep_monitor"},{"name":"host","value":"runnervmkkn4f"},{"name":"thread","value":"3022-MainThread"},{"name":"framework","value":"pytest"},{"name":"language","value":"cpython3"},{"name":"package","value":"tests.unit_tests.test_antenna_sleep_monitor"}],"url":"","historyId":"fae683c65a1569e57edf97ba3d3c1733.d41d8cd98f00b204e9800998ecf8427e","reportLinks":[]},{"id":"92a4af40be86f4ad5984c5a050a762a7","name":"test_no_wake_during_recovery_reads","fullName":"tests.unit_tests.test_antenna_sleep_monitor#test_no_wake_during_recovery_reads","environment":"default","status":"passed","start":1782989078293,"stop":1782989085839,"duration":7546,"labels":[{"name":"tag","value":"asyncio"},{"name":"parentSuite","value":"tests.unit_tests"},{"name":"suite","value":"test_antenna_sleep_monitor"},{"name":"host","value":"runnervmmklqx"},{"name":"thread","value":"3026-MainThread"},{"name":"framework","value":"pytes